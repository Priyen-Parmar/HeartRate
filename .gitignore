# Data (raw UBFC videos, legacy & new preprocessed caches) - large, licence-restricted
data/
*.zip

# Model weights / checkpoints: trial checkpoints (archive/trial_models/) and the old system's weights
# (archive/legacy_system/deploy/models/) stay local, the DEPLOYED models are versioned
# (needed to run the app on another machine: 10 x ~2.5 MB + 52 MB face detector)
*.pt
!models/vitalnet/*.pt
!models/face_detector/*.pt

# Other projects that used to live in this folder
other_projects/

# Runtime outputs / caches
.cache/
outputs/*.csv
outputs/*.mp4
outputs/*.mkv
outputs/*.avi
outputs/*.png
# screenshots / photos of people (privacy)
/Screenshot*.png
/image*.png
outputs/pipeline_eval/
results/logs/
archive/trial_models/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
node_modules/
*.db
*.db-shm
*.db-wal
*.log
.DS_Store
Thumbs.db

# packaged builds (e.g. the Mac zip kit: optipulse/ + models/ + launchers/macos/run_mac.sh)
dist/

# local Python environments (e.g. created by launchers/macos/run_mac.sh)
.venv/
